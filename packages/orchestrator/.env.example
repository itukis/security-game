SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWKS_URL=https://xxxxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Backend only. Never put this value in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Leave empty for current ES256/JWKS projects. Set only for legacy HS256 projects.
SUPABASE_JWT_SECRET=
